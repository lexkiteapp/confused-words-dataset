  {
   "id": "affect-effect",
   "words": [
    {
     "w": "affect",
     "pos": "v",
     "def": "to change or influence",
     "ex": "Lack of sleep can affect your memory."
    },
    {
     "w": "effect",
     "pos": "n",
     "def": "a change caused by something",
     "ex": "Music has a calming effect on babies."
    }
   ],
   "pattern": "n ↔ v",
   "mistakes": [
    {
     "wrong": "It has a big affect on me.",
     "right": "It has a big effect on me.",
     "note": "After a/the/big you need the noun effect."
    }
   ],
   "tip": "Affect = Action (verb), Effect = End result (noun).",
   "lesson": "word-formation"
  },
  {
   "id": "say-tell",
   "words": [
    {
     "w": "say",
     "pos": "v",
     "def": "speak words",
     "ex": "She said that she was tired."
    },
    {
     "w": "tell",
     "pos": "v",
     "def": "give information to a person",
     "ex": "She told me the truth."
    }
   ],
   "pattern": "v ↔ v",
   "mistakes": [
    {
     "wrong": "He said me that…",
     "right": "He told me that…",
     "note": "A listener right after the verb → tell."
    }
   ],
   "tip": "tell + person; say + words (or say to sb). Fixed: tell a story/the truth/a lie, say sorry.",
   "lesson": "reported-speech"
  },
